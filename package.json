{
  "name": "torsten-linnecke-resume",
  "version": "1.0.0",
  "description": "Minimal and formal résumé (CV) website for print, mobile, and desktop.",
  "homepage": "https://github.com/p3LZ3r/universal-resume",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3LZ3r/universal-resume.git"
  },
  "bugs": {
    "url": "https://github.com/p3LZ3r/universal-resume/issues"
  },
  "license": "NonCommercial-ShareAlike 1.0 Generic",
  "author": "Torsten Linnecke <tlinnecke@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"postcss ./tailwind.css -o docs/build.css --watch\" \"vite docs\"",
    "serve": "npm run dev",
    "build": "cross-env NODE_ENV=build postcss ./tailwind.css -o ./docs/build.css",
    "preview": "npm run build && vite preview --outDir docs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.4",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.5"
  }
}
